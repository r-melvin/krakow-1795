[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/texture_mipmap_bias=-0.25
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
mesh_lod/lod_change/threshold_pixels=2.0

[shader_globals]

snow_cover={
"type": "float",
"value": 1.0
}
ground_snow={
"type": "float",
"value": 0.75
}
wetness={
"type": "float",
"value": 0.0
}
wind={
"type": "vec2",
"value": Vector2(0, 0)
}
precipitation={
"type": "float",
"value": 0.0
}
