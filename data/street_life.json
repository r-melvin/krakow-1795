 "messages": {
  "cutpurse_player": "A rzezimieszek (cutpurse) brushed past you in the crowd. Your purse is {n} złoty lighter. He is running for the alley.",
  "cutpurse_dropped": "The cutpurse drops your coins on the cobbles.",
  "cutpurse_recovered": "You pick up your {n} złoty.",
  "mug_paid": "You pay {n} złoty. The thugs melt back into the dark.",
  "mug_fought": "Both thugs lie in the snow. Nobody in this alley will say they saw anything.",
  "mug_ran": "You run. Their laughter follows you out of the alley.",
  "mug_passed": "The thugs know you for a friend of the boatmen and let you pass.",
  "saw_burglar": "You saw a man prising a shutter behind the row. A word to the watch might be worth something, or a word to the underworld.",
  "room": "Matka Weronika takes {n} złoty. A back stair, a room with a candle: no watchman will look for you here for a while.",
  "gossip": "Gossip from the red lantern: {what}",
  "posters": "A corporal tears a printed leaf from the notice board and feeds a sheaf of them to the brazier. Somebody's leaves; not yet yours.",
  "flogging": "A drum at the Town Hall. The Austrians are flogging a man for seditious print. The crowd watches in silence.",
  "raid": "Soldiers at the red lantern: a Visitation. The women vanish inside.",
  "frozen": "The old woman in the doorway of the lodging house has stopped shivering.",
  "drink": "The gorzałka burns all the way down. You are warmer; he is wiser.",
  "warm": "You stand by the madam's stove. For a minute nobody wants anything from you.",
  "slap": "A slap across the face, open-handed and practised. ({h} of {max})",
  "knife": "The pimp's knife opens your sleeve and the arm under it. ({h} of {max})",
  "free_room": "The doorman looks at his boots. The back stair is yours for a while.",
  "cowed": "The leader looks at your face, at your friends in it, and steps aside.",
  "kind": "You press a coin into the prisoner's hand. The guard pretends not to see.",
  "riot": "A riot on the Rynek: {cause}. The watch will not stand for it long.",
  "riot_calm": "The crowd's shouting drops a note. Some of them are looking for the way home.",
  "riot_rile": "The crowd roars. Somebody throws the first stone.",
  "riot_crushed": "A volley. The smoke clears on the dead in the snow, and the square empties.",
  "riot_dispersed": "The crowd breaks up into men going home, as if nothing happened."
 },
