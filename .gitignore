.godot/
*.uid
.blend1
assets/blender/*.blend1

# Baked texture cache (regenerated by build_assets.py when missing)
assets/textures/

# Scratch and packaging
assets/blender/_tmp_*.py
*.blend1
*.tmp
.DS_Store
Thumbs.db
export/
*.pck
*.zip

# Generated models (buildings, props, interiors, animals, characters). Not tracked: ~1.3 GB of glTF.
# Either download the "models" zip from the GitHub release or rebuild with tools/build_all.sh.
assets/models/*.glb
assets/models/*.glb.import
assets/ground/*.png
assets/ground/*.png.import
__pycache__/
*.pyc
assets/models/*.png
assets/models/*.png.import
docs/**/*.import
assets/models/*.jpg
assets/models/*.jpg.import

# Third-party animal sources, fetched by tools/fetch_animals.sh (only the LICENSE.txt files are committed)
assets/third_party/*/*
!assets/third_party/*/LICENSE.txt
